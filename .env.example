# Optional. Leave unset to run the deterministic scripted engine instead —
# the demo works either way.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults are tuned for chat latency.
# BOOKLY_MODEL=claude-sonnet-5           # writes the customer-facing replies
# BOOKLY_ROUTER_MODEL=claude-haiku-4-5   # intent classification only
# BOOKLY_EFFORT=low                      # low | medium | high | xhigh | max
# BOOKLY_THINKING=off                    # off | adaptive (adaptive is slower)
#
# Fastest possible, at some cost to how the replies read:
# BOOKLY_MODEL=claude-haiku-4-5
#
# Most capable, noticeably slower:
# BOOKLY_MODEL=claude-opus-5
# BOOKLY_JWT_SECRET=change-me
# BOOKLY_MOCK_LLM=1        # force the scripted engine even with a key present

# Email. With no SMTP host set, handoff emails are written to outbox/ as .eml
# files and served at /api/outbox — no credentials needed.
# BOOKLY_SMTP_HOST=smtp.gmail.com
# BOOKLY_SMTP_PORT=587
# BOOKLY_SMTP_USER=you@gmail.com
# BOOKLY_SMTP_PASSWORD=your-app-password
# BOOKLY_EMAIL_FROM=Bookly Support <support@bookly.example>
# Send every outbound message to you instead of the account holder:
# BOOKLY_DEMO_EMAIL=you@gmail.com
